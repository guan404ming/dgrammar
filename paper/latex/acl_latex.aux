\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces JSB difficulty spectrum, B200, $T{=}128$. \textsc  {Dgr.} denotes Dgrammar. Latencies in seconds; Timeout counts $\geq \!120$\,s instances. $n$ is matched-instance count after llguidance skips. $^\dagger $IG-CD \citep  {mundler2025} compiles only a subset of each split ($449/577$ easy, $383/586$ medium, $245/368$ hard, i.e.\ $22$--$35\%$ rejected, identical across backbones); its rows are over that compilable subset, so schema@1 is not instance-matched to the other methods. On Dream its soft (\texttt  {stopit}) timeout cannot interrupt a running kernel, so a few hard instances overshoot the $120$\,s budget. Hyperparameters in App.~\ref {app:hyperparams}.}}{5}{table.caption.6}\protected@file@percent }
\newlabel{tab:main}{{1}{5}{JSB difficulty spectrum, B200, $T{=}128$. \textsc {Dgr.} denotes Dgrammar. Latencies in seconds; Timeout counts $\geq \!120$\,s instances. $n$ is matched-instance count after llguidance skips. $^\dagger $IG-CD \citep {mundler2025} compiles only a subset of each split ($449/577$ easy, $383/586$ medium, $245/368$ hard, i.e.\ $22$--$35\%$ rejected, identical across backbones); its rows are over that compilable subset, so schema@1 is not instance-matched to the other methods. On Dream its soft (\texttt {stopit}) timeout cannot interrupt a running kernel, so a few hard instances overshoot the $120$\,s budget. Hyperparameters in App.~\ref {app:hyperparams}}{table.caption.6}{}}
